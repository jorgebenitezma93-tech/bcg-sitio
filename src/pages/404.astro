---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base title="Página no encontrada — Benítez Consulting Group" description="La página que busca no existe o cambió de dirección." solidNav noindex>
  <section class="nf section">
    <div class="container nf__inner">
      <Logo variant="positive" layout="mark" size={96} decorative />
      <p class="label label--copper">Error 404</p>
      <h1>Esta celda de la red está vacía.</h1>
      <p>La página que busca no existe o cambió de dirección. Puede volver al inicio o ir directamente al contacto.</p>
      <div class="nf__actions">
        <a class="btn" href="/">Volver al inicio</a>
        <a class="btn btn--ghost" href="/#contacto">Contacto</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-items: center; padding-top: calc(var(--nav-h) + 2rem); background: var(--ivory); }
  .nf__inner { display: grid; gap: 1.25rem; justify-items: start; max-width: 40rem; margin-inline: 0; }
  .nf h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); }
  .nf p { margin: 0; color: var(--ink-2); }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 0.75rem; }
</style>
