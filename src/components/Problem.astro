---
import Logo from './Logo.astro';
---

<section id="problema" class="problem section" aria-labelledby="problema-titulo">
  <div class="container problem__grid">
    <!-- Aquí aterriza la celda de la red convertida en logo -->
    <div class="problem__slot" data-logo-slot>
      <Logo variant="positive" layout="mark" size={200} decorative class="problem__logo" />
    </div>
    <div class="problem__body">
      <p class="label label--copper reveal" id="problema-titulo">El problema</p>
      <p class="problem__text reveal" style="--d:.08s">
        ¿Una pieza que falla, un proceso que no rinde, un proyecto que necesita sustento antes de invertir?
        Diagnosticamos con método, no con opiniones, y entregamos conclusiones que usted puede auditar y defender ante
        su cliente o su consejo.
      </p>
    </div>
  </div>
</section>

<style>
  .problem { background: var(--ivory); padding-block: clamp(5rem, 11vw, 9rem); }
  .problem__grid {
    display: grid;
    grid-template-columns: minmax(180px, 0.55fr) 1.45fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .problem__slot {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    width: min(100%, 200px);
    justify-self: center;
  }
  :global(.fx-on) .problem__slot :global(.problem__logo) { visibility: hidden; }
  .problem__body .label { margin-bottom: 1.5rem; display: block; }
  .problem__text {
    max-width: 34em;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 1rem + 1.7vw, 2.35rem);
    line-height: 1.34;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .problem__grid { grid-template-columns: 1fr; text-align: left; }
    .problem__slot { width: 150px; justify-self: start; aspect-ratio: auto; height: 150px; }
    .problem__slot :global(.problem__logo) { --s: 150px !important; }
  }
</style>
