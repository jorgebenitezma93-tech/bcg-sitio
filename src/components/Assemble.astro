---
/**
 * Logo "viajero": una celda de la red cristalina del hero se separa, se
 * convierte en el isotipo y viaja hasta el diagrama de áreas de práctica.
 * El movimiento lo calcula src/scripts/assemble.ts a partir del scroll.
 * Sin JS o con prefers-reduced-motion, este elemento no se muestra.
 */
import { B_PATH, HEX_POINTS, NODES } from '../data/brand';

// Vértices del hexágono que NO son nodos del logo (se desvanecen al formarse)
const EXTRA: [number, number][] = [
  [87, 106.77],
  [6, 60],
  [87, 13.23],
];
---

<div class="fx" data-fx aria-hidden="true">
  <svg viewBox="0 0 120 120" width="400" height="400" overflow="visible" focusable="false">
    <polygon data-fx-hex points={HEX_POINTS} fill="none" stroke-linejoin="round"></polygon>
    {EXTRA.map(([cx, cy]) => <circle data-fx-extra cx={cx} cy={cy} r="2"></circle>)}
    {NODES.map(([cx, cy]) => <circle data-fx-node cx={cx} cy={cy} r="2"></circle>)}
    <path data-fx-b d={B_PATH}></path>
  </svg>
</div>

<style>
  .fx {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 20;
    width: 400px;
    height: 400px;
    transform-origin: 0 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }
  :global(.fx-on) .fx { display: block; }
  .fx svg { width: 100%; height: 100%; }
</style>

<script>
  import '../scripts/assemble';
</script>
