---
import Logo from './Logo.astro';
---

<section id="inicio" class="hero is-dark on-dark" data-hero aria-labelledby="hero-title">
  <canvas class="hero__canvas" data-crystal aria-hidden="true"></canvas>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__inner">
    <Logo variant="inverted" size={64} class="hero__logo" />
    <p class="label label--copper hero__label">Consultoría científica · tecnológica · ingenieril</p>
    <h1 id="hero-title" class="hero__title">Convertimos conocimiento especializado en decisiones acertadas.</h1>
    <p class="hero__sub">
      Ingeniería, ciencia de materiales y asesoramiento científico para decisiones que resisten el escrutinio técnico.
    </p>
    <div class="hero__actions">
      <a class="btn" href="#contacto">
        Agendar diagnóstico
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
          ><path d="M4 10h12M11 5l5 5-5 5"></path></svg
        >
      </a>
      <a class="btn btn--ghost" href="#areas">Conocer las áreas</a>
    </div>
  </div>

  <a class="hero__cue label" href="#problema" aria-label="Desplace hacia la siguiente sección">
    <span>Desplace</span><i aria-hidden="true"></i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: calc(var(--nav-h) + 3rem) 6rem;
    background: var(--ink);
    color: var(--ivory);
    overflow: hidden;
    touch-action: pan-y;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Velo de tinta para dar lectura al texto sobre la red */
  .hero__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 70% 75% at 28% 52%, rgba(23, 37, 47, 0.9) 0%, rgba(23, 37, 47, 0.55) 55%, rgba(23, 37, 47, 0) 100%);
  }
  .hero__inner { position: relative; pointer-events: none; }
  .hero__inner :global(a) { pointer-events: auto; }

  .hero__inner :global(.hero__logo) { display: flex; width: max-content; margin-bottom: clamp(1.5rem, 4.5vh, 3rem); }
  .hero__label { display: block; margin-bottom: 1.4rem; }
  .hero__title {
    max-width: 14.5em;
    color: var(--ivory);
    font-size: var(--fs-h1);
    line-height: 1.06;
  }
  .hero__sub {
    max-width: 38rem;
    margin: 1.75rem 0 0;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ivory-dim);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    transform: translateX(-50%);
    color: var(--ivory-dim);
  }
  .hero__cue i {
    display: block;
    width: 1px;
    height: 38px;
    background: linear-gradient(var(--copper-light) 50%, transparent 50%) 0 0 / 1px 200%;
    animation: cue 2.2s var(--ease) infinite;
  }
  @keyframes cue {
    to { background-position: 0 -100%; }
  }

  @media (max-width: 640px) {
    .hero { padding-bottom: 5.5rem; }
    .hero__actions .btn { flex: 1 1 100%; }
    .hero__shade {
      background: radial-gradient(ellipse 120% 80% at 30% 55%, rgba(23, 37, 47, 0.9) 0%, rgba(23, 37, 47, 0.6) 60%, rgba(23, 37, 47, 0.1) 100%);
    }
  }
</style>

<script>
  import { initCrystal } from '../scripts/crystal';
  import { reducedMotion } from '../scripts/env';

  const host = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-crystal]');
  // Se inicia tras el primer pintado para no retrasar FCP/LCP
  if (host && canvas) requestAnimationFrame(() => setTimeout(() => initCrystal(host, canvas, reducedMotion()), 0));
</script>
