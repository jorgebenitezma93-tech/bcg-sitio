# Copie este archivo a ".env" y complete los valores.

# URL pública del sitio (para sitemap, canonical y Open Graph).
SITE_URL=https://www.example.com

# Endpoint de Formspree (https://formspree.io/f/XXXXXXXX) o de otro servicio
# compatible. Si se deja vacío, el formulario abre el cliente de correo (mailto:).
PUBLIC_FORM_ENDPOINT=
